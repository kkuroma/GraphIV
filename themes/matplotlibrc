# Every rcParam below comes from the light half of theme.json in this directory, Akiba light
# Matplotlib reads this file because .envrc points MPLCONFIGDIR here, so no script sets a style

backend:            Agg

font.family:        sans-serif
font.sans-serif:    Google Sans Flex, DejaVu Sans, sans-serif
font.size:          10

figure.facecolor:   F0EAE4
figure.edgecolor:   F0EAE4
figure.dpi:         150
savefig.facecolor:  F0EAE4
savefig.edgecolor:  F0EAE4
savefig.dpi:        150
savefig.bbox:       tight

axes.facecolor:     FFFFFF
axes.edgecolor:     D8C8C0
axes.labelcolor:    2A1E18
axes.titlecolor:    2A1E18
axes.titlesize:     11
axes.titleweight:   medium
axes.labelsize:     10
axes.linewidth:     0.8
axes.grid:          True
axes.spines.top:    False
axes.spines.right:  False
axes.prop_cycle:    cycler('color', ['902020', '1F74A8', '806000', '6048A0', '507840', '207090', 'E86060', '2A1E18'])

grid.color:         D8C8C0
grid.linewidth:     0.6
grid.alpha:         0.5

text.color:         2A1E18
xtick.color:        60504A
ytick.color:        60504A
xtick.labelsize:    9
ytick.labelsize:    9
xtick.direction:    out
ytick.direction:    out

legend.frameon:     True
legend.framealpha:  0.9
legend.facecolor:   FFFFFF
legend.edgecolor:   D8C8C0
legend.fontsize:    9

lines.linewidth:    1.8
lines.markersize:   5
